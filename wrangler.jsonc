{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "kovalamhomestay-in",
  "compatibility_date": "2026-10-23",
  "assets": {
    "directory": "./public",
  },
  "observability": {
    "enabled": true,
  },
  "routes": [
    { "pattern": "kovalamhomestay.in", "custom_domain": true },
    { "pattern": "www.kovalamhomestay.in", "custom_domain": true },
  ],
}
